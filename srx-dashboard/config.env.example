# srx-dashboard / config.env.example
#
# Copy to config.env, edit, then `source ./config.env` before launching.
# config.env is gitignored.

# --- HTTP server -------------------------------------------------------------
export SRX_DASH_BIND=127.0.0.1
export SRX_DASH_PORT=8081
# No built-in authentication: never expose this backend directly to a network.
# For an authenticated HTTPS reverse proxy, set its exact browser origin:
# export SRX_DASH_PUBLIC_ORIGIN=https://dashboard.example.org
# Prefer loopback with a same-host proxy. Nonloopback binding fails closed unless
# BOTH an HTTPS public origin and this explicit trust-boundary declaration exist:
# export SRX_DASH_TRUST_PROXY=1
# This flag does not install auth/firewall rules! Restrict backend ingress to the
# authenticated proxy; preserve browser Host/Origin; disable SSE buffering.
# See README.md for required proxy controls. No credentials belong in this file.

# --- Remote client (where the probe runs) ------------------------------------
# SSH target in `user@host` form. Must be reachable via key auth from this
# machine — no passwords in this file. Root workloads require a separately
# reviewed privilege policy. The legacy sudoers installer grants general
# Python interpreters root execution, not a narrow workload permission;
# do not use it as the security boundary for untrusted dashboard users.
export SRX_CLIENT_HOST=                             # e.g. user@203.0.113.10
export SRX_CLIENT_REPO=/home/user/srx               # `git clone` destination on client

# --- Traffic target ----------------------------------------------------------
# The `--target` and `--src` values passed to deploy/srx_workload.py.
# `SRX_TARGET` is the server (destination); `SRX_SRC` is the client's own IP
# stamped onto crafted scapy packets. Blank SRX_SRC omits --src and lets the CLI
# select the source.
export SRX_TARGET=                                  # e.g. 203.0.113.11
export SRX_SRC=                                     # e.g. 203.0.113.10

# --- Batch history -----------------------------------------------------------
export SRX_HISTORY_MAX=30
# export SRX_HISTORY_FILE=/var/lib/srx-dashboard/runall-history.json
