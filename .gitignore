# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
venv/
.venv/
env/
ENV/

# Local probe configuration (NEVER commit real credentials/hosts).
# Keep only the documented example.
config/probe_config.yaml
probe_config.yaml

# Dashboards runtime state / secrets (see pingapp/ and srx-dashboard/).
# Only the *.env.example files are tracked.
*.env
!*.env.example
pingapp/state.json
pingapp/state.json.tmp
pingapp/server.log
pingapp/start.log
pingapp/dash.log
srx-dashboard/runall-history.json
srx-dashboard/runall-history.json.tmp
srx-dashboard/dashboard.log
srx-dashboard/start.log

# Packet captures / ground-truth artifacts
*.pcap
*.pcapng
captures/

# Playwright artifacts
playwright-report/
test-results/
*.webm
screenshots/
*.png

# Pytest / tooling caches
.pytest_cache/
.cache/
.coverage
htmlcov/
.mypy_cache/

# Editor/OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
