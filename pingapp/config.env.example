# pingapp / config.env.example
#
# Copy to config.env, edit, then `source ./config.env` before launching.
# config.env is gitignored.

# --- Ping targets ------------------------------------------------------------
# The IP to ping. Use your router / gateway.
export PING_TARGET=192.0.2.1                      # RFC 5737 placeholder

# Payload size for the do-not-fragment (DF) probe. The wire size = value + 28.
# Must not exceed the smallest MTU on the outbound path, or every DF probe
# will fail locally. From WSL2 (MTU 1280) the ceiling is 1252.
export PING_BIG_SIZE=1252

# Sampling cadence in seconds.
export PING_INTERVAL=1.0

# --- HTTP server -------------------------------------------------------------
export PING_PORT=8080

# --- Retention ---------------------------------------------------------------
export PING_HISTORY_SAMPLES=300                   # live-chart raw samples
export PING_BUCKET_SEC=60                         # aggregation window
export PING_RETAIN_DAYS=7                         # rolling long-window history

# --- WiFi probe (optional) ---------------------------------------------------
# Set WIFI_HOST to enable. The dashboard opens a persistent SSH stream and
# runs `iw dev <iface> link` every WIFI_INTERVAL seconds. Requires SSH key
# auth to the host (no passwords in this file).
#
# Leave WIFI_HOST empty to disable the WiFi probe entirely.
export WIFI_HOST=                                  # e.g. user@192.0.2.10
export WIFI_IFACE=wlan0                            # remote interface name
export WIFI_SSID=                                  # display label (optional)
export WIFI_INTERVAL=3.0
